{
  "expo": {
    "name": "Hakirush Portal",
    "slug": "hakirush-portal",
    "scheme": "hakirush",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF8F3",
    "ios": {
      "bundleIdentifier": "com.provisional.hakirushportal",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "com.provisional.hakirushportal",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1C1A17"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF8F3",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#1C1A17"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hakirush Portal uses your photo library only when you choose a profile photo or an image to upload.",
          "cameraPermission": "Hakirush Portal uses your camera to capture expense receipts and bills.",
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false,
          "configureAndroidBackup": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "provisionalIdentifiers": "ios.bundleIdentifier and android.package are PROVISIONAL (com.provisional.hakirushportal) until the owner confirms the final application id."
    }
  }
}
